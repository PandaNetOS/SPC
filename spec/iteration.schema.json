{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PandaNetOS/SPC/spec/iteration.schema.json",
  "title": "Iteration（迭代轮次 manifest）",
  "description": "每轮研究的元数据与状态。这是『自我迭代』的机器可读骨架：AI 读上一轮的 HANDOFF，写下一轮的 TASK_BRIEF，并用本文件登记。",
  "type": "object",
  "required": [
    "round",
    "game",
    "title",
    "status",
    "started_at",
    "inputs",
    "outputs",
    "deliverables"
  ],
  "additionalProperties": false,
  "properties": {
    "round": {
      "type": "string",
      "pattern": "^round[0-9]{2}$"
    },
    "game": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "title": {"type": "string", "minLength": 3, "maxLength": 120},
    "status": {
      "type": "string",
      "enum": ["planned", "in_progress", "delivered", "archived", "abandoned"]
    },
    "started_at": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "开始日期。status = \"planned\" 时为 null。"
    },
    "finished_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "executor": {
      "type": ["string", "null"],
      "description": "执行者标识（AI 模型名或人类）。"
    },
    "supersedes_round": {
      "type": ["string", "null"],
      "pattern": "^round[0-9]{2}$"
    },
    "inputs": {
      "type": "object",
      "description": "本轮消费了什么。",
      "required": ["data_version"],
      "additionalProperties": true,
      "properties": {
        "data_version": {"type": "string"},
        "upstream_fact_ids": {"type": "array", "items": {"type": "string", "pattern": "^F-[0-9]{4}$"}},
        "previous_handoff": {"type": ["string", "null"]},
        "task_brief": {"type": ["string", "null"]}
      }
    },
    "outputs": {
      "type": "object",
      "description": "本轮产出了什么（机器可读索引）。",
      "additionalProperties": true,
      "properties": {
        "new_fact_ids": {"type": "array", "items": {"type": "string", "pattern": "^F-[0-9]{4}$"}},
        "superseded_fact_ids": {"type": "array", "items": {"type": "string", "pattern": "^F-[0-9]{4}$"}},
        "refuted_fact_ids": {"type": "array", "items": {"type": "string", "pattern": "^F-[0-9]{4}$"}},
        "new_lesson_ids": {
          "type": "array",
          "items": {"type": "string", "pattern": "^L-?[0-9]{1,2}$"},
          "description": "教训 id。仓内约定为 L1 / L2 … L9（见 labs/lottery/studies/dlt/memory/lessons/LESSONS.md 的标题）。同时接受 L-01 形式。"
        },
        "new_question_ids": {"type": "array", "items": {"type": "string", "pattern": "^Q-[0-9]{3}$"}},
        "strategy_updated": {"type": "boolean", "default": false}
      }
    },
    "deliverables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "kind"],
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string"},
          "kind": {
            "type": "string",
            "enum": ["task_brief", "findings", "handoff", "script", "data", "report", "manifest"]
          },
          "note": {"type": "string"}
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string", "pattern": "^Q-[0-9]{3}$"},
      "description": "遗留给下一轮的开放问题 id。"
    },
    "planned_tasks": {
      "type": "array",
      "description": "仅当 status = \"planned\" 时使用：下一轮计划要做的任务。每项至少含 id 与 title。",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": true,
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string", "minLength": 3},
          "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3", "P4"]},
          "question": {"type": ["string", "null"], "pattern": "^Q-[0-9]{3}$"},
          "script": {"type": ["string", "null"]},
          "note": {"type": "string"}
        }
      }
    },
    "outputs_planned": {
      "type": ["object", "null"],
      "description": "仅当 status = \"planned\" 时使用：预计产出（形状同 outputs）。",
      "additionalProperties": true
    },
    "framework_revision": {
      "type": ["object", "null"],
      "description": "本轮对『研究框架本身』提出的改进（自我迭代的核心产出）。",
      "additionalProperties": true,
      "properties": {
        "proposed": {"type": "array", "items": {"type": "string"}},
        "accepted": {"type": "array", "items": {"type": "string"}},
        "rejected": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
