{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PandaNetOS/SPC/spec/strategy.schema.json",
  "title": "Strategy（彩种策略建议规则集）",
  "description": "本仓库对外输出的唯一稳定契约。其他工具（选号器、前端、Agent）消费此结构，不应直接读取 games/ 内部实现。字段只增不删；破坏性变更须提升 schema_version 主版本。",
  "type": "object",
  "required": [
    "schema_version",
    "game",
    "generated_at",
    "data_version",
    "rules_epoch",
    "disclaimer",
    "boundary",
    "rules",
    "avoid_list",
    "evidence_index"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "本契约版本。消费者应校验主版本号后再解析。"
    },
    "game": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "generated_by": {
      "type": ["string", "null"],
      "description": "生成器与版本，如 SPC-cli/0.1.0。"
    },
    "data_version": {
      "type": "string",
      "description": "依据的数据集版本，如 dlt_full_2933。"
    },
    "rules_epoch": {
      "type": "string",
      "description": "规则口径。奖金类规则必须声明，号码类规则也应声明以免误用。"
    },
    "disclaimer": {
      "type": "object",
      "required": ["is_negative_ev", "changes_win_probability", "text"],
      "additionalProperties": false,
      "properties": {
        "is_negative_ev": {
          "const": true,
          "description": "恒为 true：彩票是负期望游戏。"
        },
        "changes_win_probability": {
          "const": false,
          "description": "红线：本策略集不改变中奖概率，恒为 false。"
        },
        "text": {
          "type": "string",
          "minLength": 20,
          "description": "面向终端用户的完整免责声明，消费者必须原样展示。"
        }
      }
    },
    "boundary": {
      "type": "object",
      "description": "数学边界。给消费者一个可校验的『本策略能影响什么』的定量框架。",
      "required": ["total_combinations", "first_prize_probability", "return_rate", "optimizable_target"],
      "additionalProperties": true,
      "properties": {
        "total_combinations": {"type": "integer", "minimum": 1},
        "first_prize_probability": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "return_rate": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "optimizable_target": {
          "type": "string",
          "enum": ["expected_bonus_given_win"],
          "description": "唯一可被优化的量：中奖时的期望奖金。严禁出现 'win_probability'。"
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "description": "有效规则列表。每条都必须外键指向 FACTS.jsonl 中 status=established 的结论。",
      "items": {
        "type": "object",
      "required": ["id", "statement", "kind", "scope", "evidence_refs", "confidence", "expected_value_impact", "effectiveness_grade"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R-[0-9]{3}$"
        },
        "scope": {
          "type": "string",
          "enum": ["single", "cross"],
          "description": "★ schema_version 1.1 新增（必填）。本规则的作用域：single=只看一注号码即可判定（用 platform/core/judge.py 的 judge()）；cross=**跨注**规则，必须拿到一整组号码才能判定（用 platform/core/portfolio.py 的 judge_cross()）。消费者据此知道哪些规则可以逐注执行、哪些必须凑齐一组再判 —— 这是 1.0 缺的一层：当时 R-002 只能被『上报跳过』，没有任何地方能执行它。"
        },
          "statement": {
            "type": "string",
            "minLength": 8,
            "maxLength": 300,
            "description": "面向消费者的规则陈述。祈使句，可执行。"
          },
          "kind": {
            "type": "string",
            "enum": ["preference_shift", "collision_avoidance", "portfolio_spread", "mechanical"],
            "description": "preference_shift=改变选号偏好分布；collision_avoidance=降低撞号；portfolio_spread=组合分散；mechanical=纯机械约束（如格式）。"
          },
          "machine_rule": {
            "type": ["object", "null"],
            "description": "可供程序直接执行的约束。消费者应优先执行本字段，statement 仅作展示。",
            "additionalProperties": true,
            "properties": {
              "predicate": {
                "type": "string",
                "description": "对候选注的判定表达式，使用**受限 DSL**：`<feature_key> <op> <literal>`，多条用 and 或 or 连接（不可混用、不可加括号）。字段来自 game.yaml 的 features 定义。求值实现见 platform/core/judge.py。",
                "pattern": "^[a-z_][a-z0-9_]* *(==|!=|<=|>=|<|>) *(-?[0-9]+(\\.[0-9]+)?|true|false)( *(and|or) *[a-z_][a-z0-9_]* *(==|!=|<=|>=|<|>) *(-?[0-9]+(\\.[0-9]+)?|true|false))*$"
              },
              "action": {
                "type": "string",
                "enum": ["exclude", "penalize", "prefer", "require"]
              },
              "weight": {
                "type": ["number", "null"],
                "description": "action 为 penalize/prefer 时的相对权重。"
              }
            }
          },
          "effectiveness_grade": {
            "type": "string",
            "enum": ["A", "B", "C"],
            "description": "★ schema_version 1.4 新增（必填，T-030 / Q-008）。本规则『策略有效性』的三档标准：A=数学恒真（解析可证，无模型假设，如 R-002 自我摊薄公式）；B=统计确立（观测数据 + 样本外/测试窗验证 + 方向一致，如 R-001：后段 CI 下界>1 + r11 平台期 + r12 时序 hold-out 测试窗）；C=模型估计或探索性（依赖模型假设或样本有限）。任何规则不得声称提高中奖概率（各奖级恒定，红线）。"
          },
          "effectiveness_basis": {
            "type": "string",
            "minLength": 8,
            "description": "档位判定的依据（引用的观测/模拟/测试窗证据与口径），供消费者与复核者追溯。"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^F-[0-9]{4}$"},
            "description": "支撑本条的结论 id 列表。必须全部存在。"
          },
          "confidence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "本条规则的可信度，通常取所引用证据中的最低值。"
          },
          "expected_value_impact": {
            "type": "object",
            "required": ["metric", "direction", "changes_win_probability"],
            "additionalProperties": true,
            "properties": {
              "metric": {"type": "string", "enum": ["expected_bonus_given_win", "variance", "none"]},
              "direction": {"type": "string", "enum": ["increase", "decrease", "neutral"]},
              "magnitude_pct": {"type": ["number", "null"], "description": "百分比量级，如 121.48。仅作参考上界。"},
              "ci95": {"type": ["array", "null"], "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
              "changes_win_probability": {"const": false},
              "caveats": {"type": "array", "items": {"type": "string"}}
            }
          },
          "applicable_epochs": {
            "type": "array",
            "items": {"type": "string"},
            "description": "适用规则 epoch 列表；留空表示与规则无关（号码结构类）。"
          }
        }
      }
    },
    "avoid_list": {
      "type": "array",
      "description": "反向清单：已被证伪或无证据支持的做法。消费者应将其展示为『不要做』。",
      "items": {
        "type": "object",
        "required": ["id", "statement", "refuted_by"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^A-[0-9]{3}$"},
          "statement": {"type": "string", "minLength": 5, "maxLength": 300},
          "refuted_by": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^F-[0-9]{4}$"}
          },
          "reason": {"type": "string", "maxLength": 400}
        }
      }
    },
    "evidence_index": {
      "type": "array",
      "description": "被本文件引用的结论摘要，便于消费者离线校验而不必读全部台账。",
      "items": {
        "type": "object",
        "required": ["id", "claim", "status", "confidence"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^F-[0-9]{4}$"},
          "claim": {"type": "string"},
          "status": {"type": "string", "enum": ["established", "tentative", "refuted", "superseded"]},
          "confidence": {"type": "integer", "minimum": 1, "maximum": 5}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true,
      "description": "可追溯信息：生成脚本、迭代轮次、哈希。",
      "properties": {
        "iteration": {"type": "string", "pattern": "^round[0-9]{2}$"},
        "generator": {"type": "string"},
        "evidence_hash": {"type": ["string", "null"]}
      }
    },
    "convenience": {
      "type": "object",
      "description": "购彩便利性元数据（schema 1.3 新增）：可行域约束/代价变量，非收益变量 —— 五种投注方式每元期望回报率数学等价（F-0026 ★5），便利性只影响购买操作成本、票面复杂度与兑奖便利，不改变 ROI。消费者应展示为『怎么做最方便』，不得解读为收益信号。",
      "required": ["positioning", "is_decision_variable", "affects_expected_return", "modes"],
      "additionalProperties": false,
      "properties": {
        "positioning": {
          "type": "string",
          "minLength": 10,
          "description": "定位说明：明确『可行域约束/代价变量，非收益变量』。"
        },
        "is_decision_variable": {
          "const": true,
          "description": "恒为 true：便利性是购买决策变量。"
        },
        "affects_expected_return": {
          "const": false,
          "description": "红线：便利性不改变期望回报（F-0026 五种方式每元期望回报率等价）。"
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "description": "五种投注方式的便利性定性评分。rating 为高/中/低，note 说明操作成本与注意点。",
          "items": {
            "type": "object",
            "required": ["id", "name", "rating", "note"],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "enum": ["single", "compound", "dan_tuo", "multiplier", "extra"]
              },
              "name": {"type": "string", "minLength": 1},
              "rating": {
                "type": "string",
                "enum": ["high", "medium", "low"]
              },
              "note": {
                "type": "string",
                "maxLength": 300,
                "description": "操作成本、兑奖复杂度与排除/推荐理由。"
              }
            }
          }
        }
      }
    },
    "experience": {
      "type": "object",
      "description": "情绪体验元数据（schema 1.3 新增）：购彩效用 = 期待效用（开奖前，anticipation）+ 结果愉悦度（开奖后，= f(奖级) − 预期基线）。策略通过『预期校准』优化愉悦度：降低基线 → 中奖超预期更喜、不中少失落（anticipation-disappointment utility 模型）。",
      "required": ["positioning", "affects_expected_return", "anticipation", "expectation_calibration"],
      "additionalProperties": false,
      "properties": {
        "positioning": {
          "type": "string",
          "minLength": 10,
          "description": "情绪体验维度的定位与模型说明。"
        },
        "affects_expected_return": {
          "const": false,
          "description": "红线：情绪体验优化不改变期望回报，只改变感受。"
        },
        "anticipation": {
          "type": "object",
          "required": ["model", "design"],
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "description": "学术模型引用（如 anticipation-disappointment utility）。"
            },
            "design": {
              "type": "string",
              "description": "期待节奏设计：期数/注数如何影响期待频率与落差。"
            }
          }
        },
        "expectation_calibration": {
          "type": "object",
          "required": ["base_line", "rule"],
          "additionalProperties": false,
          "properties": {
            "base_line": {
              "type": "string",
              "description": "预期基线：中奖多为小额固定奖等现实口径。"
            },
            "rule": {
              "type": "string",
              "description": "校准规则：把基线设在『大概率中小额』而非大奖幻想。"
            }
          }
        }
      }
    },
    "psychology": {
      "type": "object",
      "description": "心理学外部学术锚点（schema 1.3 新增）：解释『大众选号偏好造成号码拥挤』的机制，支撑 R-001/R-003 撞号避让与 A-001~A-005 排除清单。仅作机制说明，不改变策略数字；非仓库数据核验结论，不得当作用户可核验的证据。",
      "required": ["positioning", "is_external_evidence", "affects_expected_return", "refs"],
      "additionalProperties": false,
      "properties": {
        "positioning": {
          "type": "string",
          "minLength": 10,
          "description": "定位：外部学术锚点，仅机制说明。"
        },
        "is_external_evidence": {
          "const": true,
          "description": "恒为 true：这些文献不是仓库数据核验结论。"
        },
        "affects_expected_return": {
          "const": false,
          "description": "红线：文献锚点不改变策略数字。"
        },
        "refs": {
          "type": "array",
          "minItems": 1,
          "description": "文献引用列表：ref=完整出处，maps_to=映射的策略对象（规则/排除项/免责声明），role=在该对象中的作用。",
          "items": {
            "type": "object",
            "required": ["ref", "maps_to", "role"],
            "additionalProperties": false,
            "properties": {
              "ref": {"type": "string", "minLength": 5},
              "maps_to": {
                "type": "array",
                "minItems": 1,
                "items": {"type": "string"}
              },
              "role": {
                "type": "string",
                "maxLength": 200
              }
            }
          }
        }
      }
    }
  }
}
