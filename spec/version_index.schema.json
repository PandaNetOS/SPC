{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PandaNetOS/smartpickcore/spec/version_index.schema.json",
  "title": "VersionIndex（仓库版本索引 versions.json）",
  "description": "全仓库内容版本登记表。权威源是 versions.json；VERSION_INDEX.md 是它的人读派生物。用于让 AI 与工具一望即知『每份结论性内容的版本、产出轮次、更新日』。",
  "type": "object",
  "required": ["index_version", "repo", "generated_at", "levels", "entries"],
  "additionalProperties": false,
  "properties": {
    "index_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "本索引文件自身的结构版本。仅在条目字段增减时提升。"
    },
    "repo": {
      "type": "string",
      "description": "仓库标识"
    },
    "generated_at": {
      "type": "string",
      "description": "本索引生成/最近一次更新的日期（YYYY-MM-DD）"
    },
    "current_iteration": {
      "type": ["string", "null"],
      "pattern": "^r[0-9]{2}$",
      "description": "当前正在进行的轮次。跨轮次新增条目的 iteration 默认取此值。"
    },
    "framework_version": {
      "type": ["string", "null"],
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "★ 框架层（framework/）的独立版本。与包版本 __version__ 解耦 —— 框架演进节奏与库代码不同。"
    },
    "levels": {
      "type": "object",
      "description": "分级定义。键为级别代号（A/B/C/D），值为该级别的说明。",
      "required": ["A", "B", "C", "D"],
      "additionalProperties": {
        "type": "object",
        "required": ["name", "versioned", "field", "reason"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string"},
          "versioned": {"type": "boolean"},
          "field": {"type": ["string", "null"]},
          "reason": {"type": "string"}
        }
      }
    },
    "entries": {
      "type": "array",
      "description": "逐文件登记。",
      "items": {
        "type": "object",
        "required": ["path", "level", "kind"],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "仓库相对路径（正斜杠）"
          },
          "level": {
            "enum": ["A", "B", "C", "D"],
            "description": "A 结论性内容 / B 结构性文档 / C 机器契约（用自身既有版本字段） / D 纯数据（用 SHA256）"
          },
          "kind": {
            "type": "string",
            "description": "内容类型，便于按类检索。如 fact_ledger / lesson_library / iteration_artifact / strategy / schema / doc / data"
          },
          "content_version": {
            "type": ["string", "null"],
            "pattern": "^[0-9]+\\.[0-9]+$",
            "description": "★ 内容版本（主.次）。答『这份内容改过几版』。与 schema_version / config_version / data_version 并存，各答不同问题。"
          },
          "version_ref": {
            "type": ["string", "null"],
            "description": "C 级条目引用自身既有版本字段的路径或字段名，如 'schema_version' 或 'manifest.data_version'。"
          },
          "ref_version": {
            "type": ["string", "null"],
            "description": "C 级条目在索引中镜像的既有版本值（如 '2.0' / 'dlt_full_2933'），便于一眼看全。"
          },
          "iteration": {
            "type": ["string", "null"],
            "pattern": "^r[0-9]{2}$",
            "description": "最近一次产出/更新的轮次。"
          },
          "updated_at": {
            "type": ["string", "null"],
            "description": "最近更新日期（YYYY-MM-DD）。"
          },
          "status": {
            "enum": ["active", "superseded", "archived", "planned", "generated"],
            "default": "active",
            "description": "generated = 由 CLI 自动生成，禁止手改。"
          },
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$",
            "description": "D 级 raw 数据的 SHA256。**这是比版本号更强的完整性保证** —— 数据不版本化，但可验证未被改动。"
          },
          "note": {
            "type": ["string", "null"],
            "description": "备注，如『派生物』『模板，落后实盘』。"
          },
          "consumes": {
            "type": ["array", "null"],
            "items": {
              "type": "string",
              "pattern": "^F-[0-9]{4}$"
            },
            "description": "★ 本条目**引用了哪些结论**（FACTS.jsonl 的 F-xxxx）。用于下游新鲜度检查：若被引用的结论被 superseded 而本条目 content_version 未随之提升，校验器报错（防止上游修正后下游继续传播旧结论）。省略或空数组 = 不声明。"
          }
        }
      }
    },
    "history": {
      "type": "array",
      "description": "版本演化史（追加式，不删历史行）。",
      "items": {
        "type": "object",
        "required": ["version", "date", "change"],
        "additionalProperties": false,
        "properties": {
          "version": {"type": "string"},
          "date": {"type": "string"},
          "scope": {"type": ["string", "null"]},
          "change": {"type": "string"}
        }
      }
    }
  }
}
